# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push public key (safe to expose client-side). Generated once via
# `npx web-push generate-vapid-keys` — pair with VAPID_PRIVATE_KEY below.
VITE_VAPID_PUBLIC_KEY=

# --- Server-only secrets (set these in Vercel's serverless env, NEVER prefix
# with VITE_ or they'd ship to the browser) ---
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
